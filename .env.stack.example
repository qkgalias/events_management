
IMAGE_NAME=events-management:latest

# App/network
APP_PORT=8000
ALLOWED_HOSTS=ems.cleyyy.dev
CSRF_TRUSTED_ORIGINS=https://ems.cleyyy.dev

# Django security
SECRET_KEY=replace-with-long-random-secret
DEBUG=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=True

# Optional email
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Paths on server
DB_FILE_PATH=/opt/events_management/db.sqlite3
MEDIA_PATH=/opt/events_management/media

# Runtime
GUNICORN_WORKERS=3
